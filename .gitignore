# Panic Buy Detector - Git Ignore
# ================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/

# Data files (keep structure, ignore contents)
data/raw/*
data/processed/*
data/features/*
data/labels/*
data/reports/*
!data/*/.gitkeep

# Models (keep structure, ignore contents)
models/*
!models/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# MLflow
mlruns/
mlflow/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak

# Build artifacts
*.whl
*.tar.gz
